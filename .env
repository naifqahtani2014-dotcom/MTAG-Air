# انسخ هذا الملف باسم .env ثم عدّل القيم
# Copy this file to .env and fill in real values.

# Port the local server listens on.
PORT=3000

# Long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_this_to_a_long_random_string

# Discord webhook URL for the MTAG license-log channel.
# Kept server-side only — never sent to the browser.
DISCORD_LICENSE_WEBHOOK_URL=https://discord.com/api/webhooks/1545787334098685952/D4jGm2VEpmLSTsZzAjT1tzYOR6ABNTKT852z6mnUsmZWUn3AN-4yIsb76pbMQHUacDZ7
