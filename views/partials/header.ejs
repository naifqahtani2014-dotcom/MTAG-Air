<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' && title ? title + ' | MTAG' : 'MTAG | منظومة الطيران العالمي' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="disclaimer-bar">
    <span>⚠️ منظمة خيالية تابعة لروبلكس لا تمثل الواقع ولا تمت له بصلة.</span>
  </div>

  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="brand">
        <span class="brand-mark">✈</span>
        <span class="brand-text">
          <strong>MTAG</strong>
          <small>منظومة الطيران العالمي</small>
        </span>
      </a>

      <button class="nav-toggle" id="navToggle" aria-label="فتح القائمة">
        <span></span><span></span><span></span>
      </button>

      <nav class="main-nav" id="mainNav">
        <a href="/verify">التحقق من ترخيص</a>
        <% if (typeof user !== 'undefined' && user) { %>
          <a href="/employees/dashboard">لوحة التحكم</a>
          <a href="/licenses">التراخيص</a>
          <% if (user.role === 'Administrator') { %>
            <a href="/employees/audit">سجل التدقيق</a>
            <a href="/employees/employees-list">الموظفون</a>
          <% } %>
          <form action="/employees/logout" method="POST" class="inline-form">
            <button type="submit" class="nav-logout">خروج (<%= user.fullName %>)</button>
          </form>
        <% } else { %>
          <a href="/employees/login" class="nav-cta">دخول الموظفين</a>
        <% } %>
      </nav>
    </div>
  </header>

  <main>
