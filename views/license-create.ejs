<%- include('partials/header') %>

<section class="section">
  <div class="container">
    <div class="panel">
      <div class="panel-header">
        <h1>إنشاء ترخيص جديد</h1>
        <a href="/licenses" class="btn btn-outline btn-sm">إلغاء</a>
      </div>

      <% if (errors && errors.length) { %>
        <div class="alert alert-error">
          <strong>يرجى تصحيح الأخطاء التالية:</strong>
          <ul>
            <% errors.forEach(function(e) { %><li><%= e %></li><% }); %>
          </ul>
        </div>
      <% } %>

      <form method="POST" action="/licenses/create">
        <div class="form-grid">
          <div class="field">
            <label for="holder_name">اسم حامل الترخيص *</label>
            <input type="text" id="holder_name" name="holder_name" required maxlength="200" value="<%= formData.holder_name || '' %>">
          </div>
          <div class="field">
            <label for="company">الشركة / الجهة</label>
            <input type="text" id="company" name="company" maxlength="200" value="<%= formData.company || '' %>">
          </div>
          <div class="field">
            <label for="license_type">نوع الترخيص *</label>
            <input type="text" id="license_type" name="license_type" list="typeSuggestions" required maxlength="200" value="<%= formData.license_type || '' %>">
            <datalist id="typeSuggestions">
              <% typeSuggestions.forEach(function(t) { %><option value="<%= t %>"><% }); %>
            </datalist>
          </div>
          <div class="field">
            <label for="category">فئة الطيران *</label>
            <select id="category" name="category" required>
              <option value="" disabled <%= !formData.category ? 'selected' : '' %>>اختر الفئة</option>
              <% categories.forEach(function(c) { %>
                <option value="<%= c.value %>" <%= formData.category === c.value ? 'selected' : '' %>><%= c.label %></option>
              <% }); %>
            </select>
          </div>
          <div class="field full">
            <label for="aircraft_info">معلومات الطائرة (إن وجدت)</label>
            <input type="text" id="aircraft_info" name="aircraft_info" maxlength="500" placeholder="مثال: Boeing 737-800 — رقم التسجيل MT-1234" value="<%= formData.aircraft_info || '' %>">
          </div>
          <div class="field">
            <label for="issue_date">تاريخ الإصدار *</label>
            <input type="date" id="issue_date" name="issue_date" required value="<%= formData.issue_date || '' %>">
          </div>
          <div class="field">
            <label for="expiration_date">تاريخ الانتهاء *</label>
            <input type="date" id="expiration_date" name="expiration_date" required value="<%= formData.expiration_date || '' %>">
          </div>
          <div class="field">
            <label for="issued_by">صادر عن *</label>
            <input type="text" id="issued_by" name="issued_by" required maxlength="150" placeholder="مثال: هيئة MTAG للطيران المدني" value="<%= formData.issued_by || '' %>">
          </div>
          <div class="field full">
            <label for="notes">ملاحظات إضافية</label>
            <textarea id="notes" name="notes" maxlength="2000"><%= formData.notes || '' %></textarea>
          </div>
        </div>

        <p class="hint">سيتم إصدار رقم ترخيص فريد تلقائياً بصيغة <strong>077.XXXXXX.MTAG</strong> عند الحفظ.</p>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">إصدار الترخيص</button>
          <a href="/licenses" class="btn btn-outline">إلغاء</a>
        </div>
      </form>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
